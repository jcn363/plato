    fn show_redaction_menu(
        &mut self,
        file_path: &PathBuf,
        _total_pages: usize,
        _rq: &mut RenderQueue,
        _context: &mut Context,
    ) -> Result<(), Error> {
        self.mode = ManipulationMode::DefiningRedaction(file_path.clone(), 0, None);
        Ok(())
    }
